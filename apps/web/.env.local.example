# Copy this file to .env.local and fill in real values from your Supabase
# project settings (Project Settings -> API). Never commit .env.local.
#
# The values below are obviously-fake placeholders, not real credentials.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Same value as the Edge Function secret VAPID_PUBLIC_KEY (see
# supabase/functions/.env.local.example) — the public key is not a secret,
# it just needs the NEXT_PUBLIC_ prefix Next.js requires for client-side
# access. Generate a real pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=fake-vapid-public-key-not-real
