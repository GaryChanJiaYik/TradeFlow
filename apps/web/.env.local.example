# Copy this file to .env.local and fill in real values from your Supabase
# project settings (Project Settings -> API). Never commit .env.local.
#
# The values below are obviously-fake placeholders, not real credentials.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Same value as the Edge Function secret VAPID_PUBLIC_KEY (see
# supabase/functions/.env.local.example) — the public key is not a secret,
# it just needs the NEXT_PUBLIC_ prefix Next.js requires for client-side
# access. Generate a real pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=fake-vapid-public-key-not-real

# The following are only needed if you want to run the Next.js app against a
# remote Supabase project (not the local `supabase start` stack). They are
# not needed for local development against the local stack, since the CLI injects
# them automatically. If you do want to run against a remote project, copy the
# values from your Supabase project settings (Project Settings -> Database -> Connection Pooling -> Connection String) and fill them in here. Never commit these values.
SUPABASE_DB_PASSWORD=your-password-here
