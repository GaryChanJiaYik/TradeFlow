# Edge Function secrets for the "tick" function. In production these are
# set via `supabase secrets set <NAME>=<value>` (never committed) against
# the linked project. For local `supabase functions serve` verification,
# copy this file to `.env.local` (gitignored — see supabase/.gitignore) and
# pass it with `--env-file supabase/functions/.env.local`.
#
# The values below are obviously-fake placeholders, not real credentials.

# OANDA practice-account API credentials. Never a live/production OANDA
# token. See handoff/BUILD-LOG.md for why "live" OANDA_ENV has no code path.
OANDA_API_TOKEN=fake-oanda-api-token-not-real
OANDA_ACCOUNT_ID=fake-oanda-account-id
OANDA_ENV=practice

# Web Push VAPID keypair. Generate a real one with
# `npx web-push generate-vapid-keys` — see docs/SETUP.md. VAPID_PUBLIC_KEY
# must match apps/web's NEXT_PUBLIC_VAPID_PUBLIC_KEY exactly (same keypair).
VAPID_SUBJECT=mailto:fake-placeholder@example.com
VAPID_PUBLIC_KEY=fake-vapid-public-key-not-real
VAPID_PRIVATE_KEY=fake-vapid-private-key-not-real

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are NOT listed here: when running
# against the local `supabase start` stack, the CLI injects them
# automatically. Against a linked remote project they come from
# `supabase secrets set` (production) or your own --env-file entry for a
# one-off remote-targeted local serve — never hard-code the service role
# key into a tracked file.
